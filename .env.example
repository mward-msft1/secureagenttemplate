# ─────────────────────────────────────────────────────────────────────────────
# Azure Tenant / Identity
# ─────────────────────────────────────────────────────────────────────────────

# Azure Active Directory / Entra tenant identifier.
# Found in Azure Portal → Azure Active Directory → Overview → Tenant ID.
AZURE_TENANT_ID=your-tenant-id-here

# Service principal (app registration) client ID.
# Found in Azure Portal → App registrations → <your app> → Application (client) ID.
AZURE_CLIENT_ID=your-client-id-here

# Service principal client secret.
# Rotate regularly; store in Key Vault for production workloads.
# Least-privilege: grant only the roles required by each adapter (see docs/configuration.md).
AZURE_CLIENT_SECRET=your-client-secret-here

# ─────────────────────────────────────────────────────────────────────────────
# Microsoft Purview
# ─────────────────────────────────────────────────────────────────────────────

# Fully qualified Purview account endpoint.
# Format: https://<account-name>.purview.azure.com
PURVIEW_ENDPOINT=https://your-purview-account.purview.azure.com

# Purview account name (used for management-plane operations).
PURVIEW_ACCOUNT_NAME=your-purview-account-name

# ─────────────────────────────────────────────────────────────────────────────
# Microsoft 365 / Graph API (A365)
# ─────────────────────────────────────────────────────────────────────────────

# Microsoft Graph API base URL. Rarely changes; included for override capability.
GRAPH_API_ENDPOINT=https://graph.microsoft.com/v1.0

# Comma-separated list of Graph permission scopes to request.
# pydantic-settings v2 expects a JSON-encoded list for array fields.
# Examples:
#   Single scope:   GRAPH_SCOPES=["https://graph.microsoft.com/.default"]
#   Multiple scopes: GRAPH_SCOPES=["https://graph.microsoft.com/.default","openid"]
# Least-privilege: request only the scopes your agent actually needs.
GRAPH_SCOPES=["https://graph.microsoft.com/.default"]

# ─────────────────────────────────────────────────────────────────────────────
# Microsoft Entra ID (directory / identity operations)
# ─────────────────────────────────────────────────────────────────────────────

# Azure AD authority host. Defaults to the public cloud.
# Change for sovereign clouds: https://login.microsoftonline.us (US Gov),
# https://login.chinacloudapi.cn (China), etc.
AZURE_AUTHORITY_HOST=https://login.microsoftonline.com

# ─────────────────────────────────────────────────────────────────────────────
# Agent runtime settings
# ─────────────────────────────────────────────────────────────────────────────

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Set to "true" to enable structured JSON logging (recommended for production).
LOG_JSON=false

# Set to "true" to mask PII/sensitive values in log output.
LOG_MASK_SENSITIVE=true

# ─────────────────────────────────────────────────────────────────────────────
# Local development helpers (do NOT set these in production)
# ─────────────────────────────────────────────────────────────────────────────

# Set to "true" to skip real SDK calls and return mock responses.
# Useful for local iteration without Azure credentials.
MOCK_SDK_CALLS=false
